# Copy to .env.local and fill in. With any of the required values missing,
# the app runs the offline demo engine instead of Firebase AI Logic.

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check with reCAPTCHA v3 (required: Firebase AI Logic calls are App Check protected)
VITE_RECAPTCHA_SITE_KEY=

# Set to 1 in local development to print an App Check debug token in the console
# (register it in Firebase console > App Check > Apps > Manage debug tokens).
VITE_APPCHECK_DEBUG=

# Optional: cloud model for the lab and the remote-line fallback
VITE_CLOUD_MODEL=gemini-3.5-flash-lite

# Optional: base path for GitHub Pages, e.g. /cold-case-lab/
VITE_BASE=/
